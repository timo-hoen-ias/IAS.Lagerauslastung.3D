PORT=3001

# Mehrere DBs: Liste der Verbindungs-IDs, kommagetrennt.
# Für jede ID einen Block WM_DB_<id>_SERVER/_DATABASE/_USER/_PASSWORD anlegen.
# Die Auswahl in der Kopfleiste zeigt standardmäßig die ID als Anzeigename —
# über WM_DB_<id>_NAME lässt sich stattdessen ein eigener Alias vergeben.
WM_DBS=default

WM_DB_default_SERVER=localhost
WM_DB_default_DATABASE=oldemoreweabfd
WM_DB_default_USER=sa
WM_DB_default_PASSWORD=Start11!
# WM_DB_default_NAME=Produktion

# Weitere DB, z. B.:
# WM_DBS=default,neu
# WM_DB_neu_SERVER=localhost
# WM_DB_neu_DATABASE=NeueDatenbank
# WM_DB_neu_USER=sa
# WM_DB_neu_PASSWORD=...
# WM_DB_neu_NAME=Testsystem
